generator client {
  provider = "prisma-client-js"
}

// Vercel's Neon integration auto-provisions its own env var names rather
// than the plain DATABASE_URL/DIRECT_URL pair Prisma's docs assume, so we
// point at the ones it actually creates instead of asking the project
// owner to hand-copy values into new variables.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Brother {
  id           String   @id @default(cuid())
  name         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A brother may have at most one linked account (enforced by the @unique
  // on BrotherAccount.brotherId below) and may publish many products.
  account           BrotherAccount?
  products          Product[]
  registrationCodes RegistrationCode[]
  orderItems        OrderItem[]

  @@map("brothers")
}

// The login identity for an existing Brother record. Kept as a separate
// model (not merged into Brother) so a brother row can exist with no
// account yet, and so the admin's plain Brother CRUD never has to touch
// credentials at all.
model BrotherAccount {
  id                  String    @id @default(cuid())
  brotherId           String    @unique
  brother             Brother   @relation(fields: [brotherId], references: [id], onDelete: Cascade)
  email               String    @unique
  passwordHash        String
  bio                 String?
  photoUrl            String?
  disabled            Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())

  sessions BrotherSession[]

  @@map("brother_accounts")
}

model BrotherSession {
  id               String   @id @default(cuid())
  tokenHash        String   @unique
  brotherAccountId String
  brotherAccount   BrotherAccount @relation(fields: [brotherAccountId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@map("brother_sessions")
}

// One-time codes the admin generates and hands to a specific brother
// privately (outside the website) so that person -- and only that person --
// can register the account linked to that Brother row. Only the hash is
// stored; the plaintext code is shown to the admin once, at generation
// time, the same way GitHub shows a personal access token only once.
model RegistrationCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  brotherId String
  brother   Brother   @relation(fields: [brotherId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("registration_codes")
}

enum ProductStatus {
  PUBLISHED
  UNPUBLISHED
}

model Product {
  id          String        @id @default(cuid())
  brotherId   String
  brother     Brother       @relation(fields: [brotherId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal       @db.Decimal(10, 2)
  description String?
  imageUrl    String?
  videoUrl    String?
  status      ProductStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems OrderItem[]

  @@index([status, createdAt])
  @@map("products")
}

// A shopping customer -- deliberately its own model/session/cookie system,
// entirely separate from Admin and BrotherAccount, so a customer session can
// never be confused with (or escalated into) staff access.
model Customer {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  phone               String?
  passwordHash        String
  defaultAddress      String?
  defaultCity         String?
  defaultLandmark     String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())

  sessions CustomerSession[]
  orders   Order[]

  @@map("customers")
}

model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("customer_sessions")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status          OrderStatus   @default(PENDING)
  paymentMethod   String        @default("COD")
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  customerName    String
  phone           String
  email           String
  deliveryAddress String
  city            String
  landmark        String?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items OrderItem[]

  @@index([customerId, createdAt])
  @@map("orders")
}

// Preserves purchase-time facts (name, price, seller) so a later change to
// the live Product row -- a price update, a brother editing the name, even
// the product being deleted -- never rewrites history on an existing order.
model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  brotherId             String
  brother               Brother  @relation(fields: [brotherId], references: [id], onDelete: Cascade)
  productNameSnapshot   String
  productPriceSnapshot  Decimal  @db.Decimal(10, 2)
  productImageSnapshot  String?
  quantity              Int
  lineTotal             Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([brotherId])
  @@map("order_items")
}

// Only one Admin is ever expected to exist for this small site, but the
// model isn't restricted to one so it stays simple to extend later.
model Admin {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  sessions            Session[]

  @@map("admins")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

// A single-row table used purely as an atomic "has setup already run?"
// lock: the /setup page tries to insert the row with a fixed id before
// creating the first admin. Postgres' unique constraint on id makes this
// safe even if two requests race each other.
model SetupLock {
  id Int @id

  @@map("setup_lock")
}
